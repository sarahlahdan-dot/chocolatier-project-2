<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('navbar') %>
    <br><br><br>
    <h1>Chocolatier menu</h1>
       <% chocolates.forEach((banana)=>{ %>
        <img src="<%= banana.imageUrl %>" style="width: 200px; height: auto;">
        <h3><%= banana.chocolateName %>:</h3>
        <p><%= banana.description %> </p>
        <br><br>
        <%})%>
</body>
</html>