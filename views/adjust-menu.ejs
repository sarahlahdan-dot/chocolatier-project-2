<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>update Your Own Chocolate Here!</h1>
        <% chocolates.forEach((banana)=>{ %>
        <h3> <%= banana.chocolateName %></h3>  
        <p>chocolate Type: <%= banana.chocolateType %></p>
        <p>chocolate filling: <%= banana.chocolateFilling %> </p>
        <p>box size: <%= banana.boxSize %> </p>
        <p>occasion: <%= banana.occasion %> </p>
        <br><br>
                <a href="/chocolates/update/<%= banana._id %>">update chocolate</a>
                
                <form action="/chocolates/delete/<%= banana._id %>" method="post">
                    <button type="submit">Delete chocolate</button>
                    <br>
                </form>
            

        <%})%>

</body>
</html>