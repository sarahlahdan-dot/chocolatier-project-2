<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>Create your chocolate!</h1>
    <form action="/chocolates" method="POST">
    <label>Chocolate Name</label>
    <input name="chocolateName" type="text" />

    <label>Chocolate Type</label>
    <input name="chocolateType" type="text" />

    <label>Chocolate Filling</label>
    <input name="chocolateFilling" type="text" />

    <label>Box Size</label>
    <input name="boxSize" type="text" required />

    <label>Occasion</label>
    <input name="occasion" type="text" />

    <button type="submit">Create</button>
   </form>

        <br><br><br>
        <button>Create chocolate !</button>

    </form>

</body>
</html>